{
  "id": "my-ai-sales-assistant",
  "name": "My AI Sales Assistant",
  "status": "active",
  "wordpress": {
    "service": "wordpress",
    "adminUrl": "http://localhost:8083/wp-admin",
    "pluginMount": "../../shared/plugins/ai-post-content-writer",
    "themePath": "./theme"
  },
  "databases": {
    "wordpress": {
      "service": "mysql",
      "database": "wordpress",
      "user": "wordpress",
      "host": "mysql",
      "port": 3306
    },
    "contentApi": {
      "service": "mongo",
      "database": "dbsamsung_edu",
      "host": "mongo",
      "port": 27017
    }
  },
  "shared": {
    "plugin": "../../shared/plugins/ai-post-content-writer",
    "workerService": "aipcw_worker",
    "ollamaUrl": "http://host.docker.internal:11435"
  },
  "content": {
    "languages": ["en", "vi"],
    "categories": [],
    "referenceStores": ["google-play", "app-store", "apkpure"]
  }
}

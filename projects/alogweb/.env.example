# Local development copy. Copy to .env and adjust.
SITE_URL=http://localhost:8093
HTTP_PORT=8093
HTTP_BIND_ADDRESS=127.0.0.1

MYSQL_DATABASE=alogweb_wordpress
MYSQL_USER=alogweb
MYSQL_PASSWORD=alogweb
MYSQL_ROOT_PASSWORD=root
WORDPRESS_TABLE_PREFIX=apk_
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3317

# WP spawns wp-cron by calling SITE_URL from inside the container, which does
# not resolve during the IP:port test phase. Run it from the host crontab
# instead (see README). Set to false only if you really want cron-on-pageload.
DISABLE_WP_CRON=true
# Empty = off. ANY non-empty value turns debug on (even "false").
WORDPRESS_DEBUG=1
# minor = chỉ tự cập nhật bản vá; đổi phiên bản lớn phải sửa image tag.
WP_AUTO_UPDATE_CORE=minor
# Image phải khớp phiên bản đã tạo ra dump, nếu không là chạy dữ liệu mới trên code cũ.
ALOGWEB_WP_IMAGE=7.1-php8.2-fpm
ALOGWEB_WPCLI_IMAGE=cli-php8.2
# 1 = hien admin bar o front end (mac dinh an de khop voi trang cong khai).
ALOGWEB_ADMIN_BAR=0
# Host phục vụ ảnh screenshot. Để trống thì suy ra từ SITE_URL.
# Chạy bằng IP thì không suy ra được, ảnh sẽ lấy thẳng từ Google.
ALOGWEB_STATIC_HOST=

ALOGWEB_MYSQL_VOLUME=alogweb_mysql_data
ALOGWEB_WORDPRESS_VOLUME=alogweb_wordpress_data
ALOGWEB_NGINX_LOG_VOLUME=alogweb_nginx_logs
ALOGWEB_NGINX_CACHE_VOLUME=alogweb_nginx_cache
ALOGWEB_NGINX_PAGE_CACHE_VOLUME=alogweb_nginx_page_cache
ALOGWEB_NETWORK=alogweb_net

CONTAINER_PREFIX=maa_alogweb
# Compose nhận diện stack bằng biến này, không phải bằng tên container. Một bản
# checkout khác muốn chạy song song phải đặt giá trị riêng, nếu không `up -d`
# bên này sẽ thay thế container của bên kia.
COMPOSE_PROJECT_NAME=maa-alogweb

# --- Contact form / SMTP ------------------------------------------------------
# Same names ExchangeHub uses, so one set of values configures both sites.
SITE_CONTACT_EMAIL=contact@alogweb.com
CONTACT_FORWARD_TO=contact@alogweb.com
CONTACT_FROM_EMAIL=contact@alogweb.com
# Leave empty until a real server is available; the form then reports a send
# failure instead of pretending the message went out.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_USE_TLS=true
CONTACT_SMTP_TLS_VERIFY=true
CONTACT_RATE_LIMIT_SECONDS=60
CONTACT_MIN_SUBMIT_SECONDS=3
CONTACT_ROTATION_TOLERANCE=8
